rules_version = '2';

// Regles de securite du projet Firebase des FORMULAIRES (navettes, benevolat).
// A coller dans : console Firebase > Firestore Database > onglet Regles > Publier.
// Mode d'emploi : commun/FORMULAIRES.md
service cloud.firestore {
  match /databases/{database}/documents {

    function outilConnu(outil) {
      return outil in ['navettes', 'benevolat'];
    }

    // Admin = connecte avec le compte technique de CET outil
    function estAdmin(outil) {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email == 'admin-' + outil + '@kmcfrance.github.io';
    }

    // Le formulaire accepte-t-il des reponses maintenant ?
    function formulaireOuvert(evt, outil) {
      let o = get(/databases/$(database)/documents/evenements/$(evt)/formulaires/$(outil)).data.get('ouverture', {});
      let debut = o.get('debutTs', null);
      let fin = o.get('finTs', null);
      return o.get('ouvert', false) == true
        && (debut == null || request.time >= debut)
        && (fin == null || request.time < fin);
    }

    // Une reponse bien formee
    function reponseValide() {
      let d = request.resource.data;
      return d.keys().hasOnly(['r', 'lang', 'cree', 'v'])
        && d.keys().hasAll(['r', 'lang', 'cree'])
        && d.r is map
        && d.r.size() > 0
        && d.r.size() <= 60
        && d.lang in ['fr', 'en']
        && d.cree == request.time
        && (!('v' in d) || d.v is int);
    }

    // Configuration d'un formulaire : lisible par tous, modifiable par l'admin de l'outil
    match /evenements/{evt}/formulaires/{outil} {
      allow get: if outilConnu(outil);
      allow list: if false;
      allow create, update: if outilConnu(outil) && estAdmin(outil);
      allow delete: if false;

      // Reponses : tout le monde peut en envoyer une si le formulaire est ouvert,
      // seul l'admin de l'outil peut les lire ou les supprimer, personne ne les modifie.
      match /reponses/{rid} {
        allow create: if outilConnu(outil) && formulaireOuvert(evt, outil) && reponseValide();
        allow read, delete: if outilConnu(outil) && estAdmin(outil);
        allow update: if false;
      }
    }

    // Tout le reste est interdit
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
